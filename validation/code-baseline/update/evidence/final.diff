+from copy import deepcopy
+import inspect
+from types import SimpleNamespace
+import unittest
+
+import store
+from service import archive_account
+from transport import handle_archive
+
+
+class ArchiveContractTests(unittest.TestCase):
+    def setUp(self):
+        store.reset()
+        self.addCleanup(store.reset)
+
+    def assert_denied_without_effects(self, operation):
+        accounts_before = deepcopy(store.ACCOUNTS)
+        events_before = deepcopy(store.EVENTS)
+        with self.assertRaisesRegex(PermissionError, '^access denied$'):
+            operation()
+        # Avoid exposing account credentials if a state assertion fails.
+        self.assertTrue(store.ACCOUNTS == accounts_before, 'denial changed accounts')
+        self.assertTrue(store.EVENTS == events_before, 'denial changed events')
+
+    def test_authorization_matrix_ignores_tenant_hint(self):
+        allowed = {('alice', 'A'), ('bob', 'B'), ('admin', 'A'),
+                   ('admin', 'B'), ('eve', 'E')}
+        for actor_id in ('alice', 'bob', 'admin', 'eve', 'unknown'):
+            for account_id in ('A', 'B', 'E'):
+                for hint in (None, '', 't1', 't2', {'tenant': 't2'}):
+                    with self.subTest(actor=actor_id, account=account_id, hint=hint):
+                        store.reset()
+                        store.EVENTS.append({'existing': 'event'})
+                        if (actor_id, account_id) not in allowed:
+                            self.assert_denied_without_effects(
+                                lambda: archive_account(actor_id, account_id, hint))
+                            continue
+                        expected_accounts = deepcopy(store.ACCOUNTS)
+                        expected_accounts[account_id]['archived'] = True
+                        result = archive_account(actor_id, account_id, hint)
+                        self.assertIsNone(result)
+                        self.assertTrue(store.ACCOUNTS == expected_accounts,
+                                        'archive changed unexpected account data')
+                        self.assertEqual(store.EVENTS, [
+                            {'existing': 'event'},
+                            {'actor_id': actor_id, 'account_id': account_id},
+                        ])
+
+    def test_missing_and_malformed_accounts_are_denied(self):
+        for account_id in (None, '', 'missing', [], {}, ['A'], 1, True, b'A'):
+            with self.subTest(account_type=type(account_id).__name__):
+                self.assert_denied_without_effects(
+                    lambda: archive_account('admin', account_id, 't1'))
+
+    def test_invalid_actors_are_denied(self):
+        for actor_id in (None, '', 'unknown', [], {}, 1, True, b'admin'):
+            with self.subTest(actor_type=type(actor_id).__name__):
+                self.assert_denied_without_effects(
+                    lambda: archive_account(actor_id, 'A', 't1'))
+
+    def test_owner_also_requires_same_tenant(self):
+        store.ACCOUNTS['E']['owner_id'] = 'alice'
+        self.assert_denied_without_effects(
+            lambda: archive_account('alice', 'E', 't2'))
+
+    def test_transport_cannot_authorize_cross_tenant_archive(self):
+        self.assert_denied_without_effects(
+            lambda: handle_archive(SimpleNamespace(actor_id='admin'), 'E',
+                                   {'tenant': 't2'}))
+
+    def test_transport_ignores_hint_for_authorized_owner(self):
+        handle_archive(SimpleNamespace(actor_id='alice'), 'A', {'tenant': 't2'})
+        self.assertTrue(store.ACCOUNTS['A']['archived'])
+        self.assertEqual(store.EVENTS, [{'actor_id': 'alice', 'account_id': 'A'}])
+
+    def test_public_signature_is_preserved(self):
+        self.assertEqual(str(inspect.signature(archive_account)),
+                         '(actor_id, account_id, tenant_hint=None)')
